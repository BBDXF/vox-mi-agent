# 复制为 .env（已被 gitignore）。docker compose --env-file .env 与 Makefile 都会读取。

# 镜像：本地构建用 vox-mi-agent:dev；正式版用 ghcr.io/<owner>/vox-mi-agent:<版本>
VOX_IMAGE=vox-mi-agent:dev

# 宿主机端口（Web 界面 + 音箱拉取音乐都走这个端口）
VOX_PORT=8080

# 宿主机数据目录 → 容器 /data（配置、数据库、小米登录令牌、曲库索引）
VOX_DATA=./data

# 宿主机音乐目录 → 容器 /music（只读）；在 Web「曲库」里添加 /music
VOX_MUSIC=./music

# 音箱访问本服务的地址：NAS 局域网 IP + VOX_PORT，例如 http://192.168.1.10:8080
# 留空则自动探测，但在 Docker 默认网络下探测到的是容器地址，音箱访问不到。
VOX_PUBLIC_BASE_URL=

# 大模型（也可以启动后在 Web「设置 → 大模型」里配置）
# provider: siliconflow / deepseek / dashscope / openai / openrouter / ollama / opencode-zen / custom
VOX_LLM_PROVIDER=siliconflow
VOX_LLM_MODEL=Qwen/Qwen3-8B
VOX_LLM_API_KEY=
